  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.headers.has('Authorization')) {",
          "    const stop = function (message) {",
          "        pm.test('Bearer token is ready for the Todo API', function () {",
          "            pm.expect.fail(message);",
          "        });",
          "        console.error(message);",
          "        pm.execution.skipRequest();",
          "    };",
          "    const configuredToken = String(pm.variables.get('todo_bearer_token') || '').trim()",
          "        || String(pm.variables.get('accessToken') || '').trim();",
          "    const token = configuredToken.replace(/^Bearer\\s+/i, '').trim();",
          "    if (!token || token.includes('{{') || token.includes('}}')) {",
          "        stop('No bearer token configured. Select Todo List API - Local and run Login - Users API, or set todo_bearer_token to the raw token.accessToken value.');",
          "    }",
          "    const parts = token.split('.');",
          "    if (parts.length !== 3 || parts.some(function (part) { return !part; })) {",
          "        stop('Expected a JWT access token. Use only token.accessToken from the login response.');",
          "    }",
          "    let claims;",
          "    try {",
          "        claims = JSON.parse(require('buffer').Buffer.from(parts[1], 'base64').toString('utf8'));",
          "        if (!claims || typeof claims !== 'object' || Array.isArray(claims)) {",
          "            throw new Error('Invalid JWT payload');",
          "        }",
          "    } catch (error) {",
          "        stop('The bearer token has an invalid JWT payload. Log in again.');",
          "    }",
          "    const expectedIssuer = pm.variables.get('jwt_issuer') || 'portfolio-users-rest-api';",
          "    const expectedAudience = pm.variables.get('jwt_audience') || 'portfolio-todo-rest-api';",
          "    if (claims.iss !== expectedIssuer) {",
          "        stop('JWT issuer mismatch. The Todo API expects ' + expectedIssuer + '. Obtain a token from the configured Users API.');",
          "    }",
          "    const audiences = Array.isArray(claims.aud) ? claims.aud : [claims.aud];",
          "    if (!audiences.includes(expectedAudience)) {",
          "        stop('JWT audience mismatch. The token must include ' + expectedAudience + '. Add it to Jwt:Audiences in the Users API configuration, restart the Users API, and log in again. A bearer header cannot fix this token.');",
          "    }",
          "    if (!Number.isFinite(claims.exp) || claims.exp <= Math.floor(Date.now() / 1000)) {",
          "        stop('The bearer token is expired or has no valid expiration. Run Login - Users API again.');",
          "    }",
          "    pm.variables.set('todo_bearer_token', token);",
          "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.headers.has('Authorization') && pm.response.code === 401) {",
          "    pm.test('Todo API accepts the bearer token', function () {",
          "        const challenge = pm.response.headers.get('WWW-Authenticate') || 'Bearer';",
          "        pm.expect.fail('JWT rejected by the Todo API. WWW-Authenticate: ' + challenge + '. Check the server signing key, issuer, audience, and token expiry, then log in again.');",
          "    });",
          "}"
        ]
      }
    }
  ]
}
